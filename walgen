<!DOCTYPE html>
<html lang="id" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aprost EVM | Secure Wallet Generator</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/ethers/5.7.2/ethers.umd.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Fira+Code:wght@400;500&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .font-mono { font-family: 'Fira Code', monospace; }
        
        /* Efek Blur Premium */
        .blur-secret { 
            filter: blur(6px); 
            user-select: none; 
            opacity: 0.6;
            transition: all 0.3s ease;
        }
        .reveal-secret { 
            filter: blur(0px); 
            user-select: text; 
            opacity: 1;
            transition: all 0.3s ease;
        }

        /* Hilangkan scrollbar tapi tetap bisa scroll */
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-950 text-slate-200 min-h-screen p-4 sm:p-8 flex items-center justify-center bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-900 via-slate-950 to-black overflow-x-hidden">

    <div id="toast-container" class="fixed bottom-6 right-6 z-50 flex flex-col gap-3 pointer-events-none"></div>

    <div class="w-full max-w-3xl bg-slate-900/40 backdrop-blur-2xl border border-slate-700/50 p-6 sm:p-10 rounded-3xl shadow-2xl transition-all duration-500">
        
        <div class="text-center mb-8">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-blue-600/20 text-blue-500 mb-4 shadow-inner border border-blue-500/20">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
            </div>
            <h2 class="text-3xl font-bold text-white tracking-tight mb-2">Aprost Wallet Generator</h2>
            <p class="text-slate-400 text-sm">Generate dompet EVM yang 100% aman (RAM-only).</p>
        </div>

        <button id="btn-generate" onclick="generateWallet()" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-semibold py-4 rounded-xl transition-all duration-300 transform active:scale-[0.98] shadow-[0_0_30px_-5px_rgba(37,99,235,0.4)] flex justify-center items-center gap-3">
            <svg class="w-5 h-5 animate-spin hidden" id="spinner" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
            <span id="btn-text">Generate Dompet Baru</span>
        </button>

        <div id="result-container" class="hidden mt-8 space-y-4 animate-in fade-in slide-in-from-bottom-6 duration-500">
            <hr class="border-slate-800 mb-6">

            <div class="bg-slate-950/80 border border-slate-700/50 rounded-xl p-4 group">
                <div class="flex justify-between items-center mb-2">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">1. Wallet Address</label>
                    <button onclick="copyData('address')" class="text-blue-400 hover:text-blue-300 transition flex items-center gap-1 text-xs font-semibold bg-blue-900/30 px-3 py-1.5 rounded-lg pointer-events-auto">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copy
                    </button>
                </div>
                <div class="text-white font-mono text-sm sm:text-base break-all" id="ui-address">...</div>
            </div>

            <div class="bg-slate-950/80 border border-slate-700/50 rounded-xl p-4 group">
                <div class="flex justify-between items-center mb-2">
                    <label class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">2. Public Key</label>
                    <button onclick="copyData('publicKey')" class="text-blue-400 hover:text-blue-300 transition flex items-center gap-1 text-xs font-semibold bg-blue-900/30 px-3 py-1.5 rounded-lg pointer-events-auto">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copy
                    </button>
                </div>
                <div class="text-slate-400 font-mono text-xs break-all" id="ui-pubkey">...</div>
            </div>

            <div class="bg-red-950/10 border border-red-900/30 rounded-xl p-4">
                <div class="flex justify-between items-center mb-3">
                    <label class="text-[10px] font-bold text-red-400 uppercase tracking-widest">3. Recovery Phrase (Rahasia)</label>
                    <div class="flex gap-2">
                        <button onclick="toggleBlur('ui-phrase', 'icon-eye-phrase')" class="text-slate-400 hover:text-white transition bg-slate-800 p-1.5 rounded-lg">
                            <svg id="icon-eye-phrase" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                        </button>
                        <button onclick="copyData('mnemonic')" class="text-emerald-400 hover:text-emerald-300 transition flex items-center gap-1 text-xs font-semibold bg-emerald-900/30 px-3 py-1.5 rounded-lg pointer-events-auto">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copy
                        </button>
                    </div>
                </div>
                <div class="text-white font-mono text-sm bg-slate-950 p-3 rounded-lg border border-slate-800 blur-secret" id="ui-phrase">...</div>
            </div>

            <div class="bg-red-950/10 border border-red-900/30 rounded-xl p-4">
                <div class="flex justify-between items-center mb-3">
                    <label class="text-[10px] font-bold text-red-400 uppercase tracking-widest">4. Private Key (Rahasia)</label>
                    <div class="flex gap-2">
                        <button onclick="toggleBlur('ui-privkey', 'icon-eye-privkey')" class="text-slate-400 hover:text-white transition bg-slate-800 p-1.5 rounded-lg">
                            <svg id="icon-eye-privkey" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path></svg>
                        </button>
                        <button onclick="copyData('privateKey')" class="text-emerald-400 hover:text-emerald-300 transition flex items-center gap-1 text-xs font-semibold bg-emerald-900/30 px-3 py-1.5 rounded-lg pointer-events-auto">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg> Copy
                        </button>
                    </div>
                </div>
                <div class="text-white font-mono text-xs break-all bg-slate-950 p-3 rounded-lg border border-slate-800 blur-secret no-scrollbar overflow-x-auto" id="ui-privkey">...</div>
            </div>

            <div class="pt-4">
                <button onclick="downloadFile()" class="w-full bg-emerald-600 hover:bg-emerald-500 text-white font-bold py-4 rounded-xl transition-all transform active:scale-[0.98] shadow-lg shadow-emerald-600/30 flex justify-center items-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                    Download File Backup
                </button>
            </div>
        </div>

    </div>

<script>
    // RAM Storage
    let walletRAM = null;

    async function generateWallet() {
        const btn = document.getElementById('btn-generate');
        const spinner = document.getElementById('spinner');
        const btnText = document.getElementById('btn-text');
        const resultContainer = document.getElementById('result-container');

        // State Memproses
        btn.disabled = true;
        spinner.classList.remove('hidden');
        btnText.innerText = "Memproses...";

        try {
            await new Promise(r => setTimeout(r, 500)); // Simulasi UI smooth loading

            // Generate Wallet
            const wallet = ethers.Wallet.createRandom();
            walletRAM = {
                address: wallet.address,
                publicKey: wallet.publicKey,
                privateKey: wallet.privateKey,
                mnemonic: wallet.mnemonic.phrase
            };

            // Masukkan ke UI
            document.getElementById('ui-address').innerText = walletRAM.address;
            document.getElementById('ui-pubkey').innerText = walletRAM.publicKey;
            document.getElementById('ui-phrase').innerText = walletRAM.mnemonic;
            document.getElementById('ui-privkey').innerText = walletRAM.privateKey;

            // Pastikan status blur aktif pada rahasia
            document.getElementById('ui-phrase').className = "text-white font-mono text-sm bg-slate-950 p-3 rounded-lg border border-slate-800 blur-secret";
            document.getElementById('ui-privkey').className = "text-white font-mono text-xs break-all bg-slate-950 p-3 rounded-lg border border-slate-800 blur-secret no-scrollbar overflow-x-auto";
            
            // Kembalikan icon mata ke mode tertutup
            const closedEye = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
            document.getElementById('icon-eye-phrase').innerHTML = closedEye;
            document.getElementById('icon-eye-privkey').innerHTML = closedEye;

            // Tampilkan Hasil
            resultContainer.classList.remove('hidden');
            
            showToast("✅ Berhasil generate dompet baru!");

        } catch (error) {
            alert("Error: " + error.message);
        } finally {
            btn.disabled = false;
            spinner.classList.add('hidden');
            btnText.innerText = "Generate Dompet Baru";
            // Kecilkan tombol generate agar user fokus ke hasil
            btn.classList.replace('bg-blue-600', 'bg-slate-800');
            btn.classList.replace('hover:bg-blue-500', 'hover:bg-slate-700');
        }
    }

    // Fungsi Copy + Toast
    function copyData(key) {
        if (!walletRAM || !walletRAM[key]) return;
        
        navigator.clipboard.writeText(walletRAM[key]).then(() => {
            let itemName = key === 'address' ? 'Alamat' : 
                           key === 'publicKey' ? 'Public Key' : 
                           key === 'mnemonic' ? 'Phrase' : 'Private Key';
            showToast(`📋 ${itemName} disalin!`);
        });
    }

    // Custom Toast Notification Premium
    function showToast(message) {
        const container = document.getElementById('toast-container');
        const toast = document.createElement('div');
        
        toast.className = 'bg-slate-800 border border-slate-600 text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3 transform translate-y-10 opacity-0 transition-all duration-300 font-medium text-sm pointer-events-auto';
        toast.innerHTML = `<span>${message}</span>`;
        
        container.appendChild(toast);

        // Animasi Masuk
        setTimeout(() => toast.classList.remove('translate-y-10', 'opacity-0'), 10);

        // Animasi Keluar setelah 3 detik
        setTimeout(() => {
            toast.classList.add('translate-y-10', 'opacity-0');
            setTimeout(() => toast.remove(), 300);
        }, 3000);
    }

    // Toggle Blur (Pengintip Mata)
    function toggleBlur(uiId, iconId) {
        const el = document.getElementById(uiId);
        const icon = document.getElementById(iconId);

        if (el.classList.contains('blur-secret')) {
            el.classList.remove('blur-secret');
            el.classList.add('reveal-secret');
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
        } else {
            el.classList.add('blur-secret');
            el.classList.remove('reveal-secret');
            icon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
        }
    }

    // Download File Logic
    function downloadFile() {
        if (!walletRAM) return;

        const content = `=== APROST SECURE WALLET ===\n\n1. ADDRESS:\n${walletRAM.address}\n\n2. PUBLIC KEY:\n${walletRAM.publicKey}\n\n3. PHRASE:\n${walletRAM.mnemonic}\n\n4. PRIVATE KEY:\n${walletRAM.privateKey}\n\n============================`;
        
        const blob = new Blob([content], { type: "text/plain" });
        const url = URL.createObjectURL(blob);
        const a = document.createElement("a");
        
        a.href = url;
        a.download = `Aprost_Wallet_${walletRAM.address.substring(0,6)}.txt`;
        document.body.appendChild(a);
        a.click();
        
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        showToast("✅ File berhasil diunduh!");
    }
</script>
</body>
</html>
